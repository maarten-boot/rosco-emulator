# The build tree, the binary and MAME's runtime output are all rebuilt inside
# the image, and .git is 1.9GB that the build does not need - without it the
# makefile just stamps the version as "unknown".
.git
.github
build/
.ccache/
# genie as built by a host build links against the host's glibc, which the
# builder image may not have; leave it out so the image builds its own.
3rdparty/genie/bin/
3rdparty/genie/build/gmake.linux/obj/
tmp/
*.log
rosco
cfg/
nvram/
snap/
diff/
*.o
*.chd
*.img
